# Configuration names only. Inject actual secrets into the server environment.
# Never add real credentials or NEXT_PUBLIC_ secrets here.

# Official Zhihu API credentials:
ZHIHU_ACCESS_SECRET=
ZHIHU_GENERATION=1

# Optional absolute path to an authenticated official CLI:
ZHIHU_CLI_PATH=

# Optional compatible Chat Completions service (all three fields required):
# Example: https://api.openai-next.com/v1/
AI_BASE_URL=
AI_MODEL=gpt-6-astra
AI_API_KEY=

# Enable only behind a trusted proxy that replaces client forwarding headers:
TRUST_PROXY=0


# Hackathon OAuth (server only; never expose App Key)
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
# Local: http://localhost:3003/api/auth/zhihu/callback
# Public: https://wanhu.asia/api/auth/zhihu/callback
ZHIHU_OAUTH_REDIRECT_URI=https://wanhu.asia/api/auth/zhihu/callback
