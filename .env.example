# Configuration names only. Inject actual secrets into the server environment.
# Never add real credentials or NEXT_PUBLIC_ secrets here.

# Official Zhihu API credentials:
ZHIHU_ACCESS_SECRET=
ZHIHU_GENERATION=1

# Optional absolute path to an authenticated official CLI:
ZHIHU_CLI_PATH=

# Optional compatible Chat Completions service (all three fields required):
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Enable only behind a trusted proxy that replaces client forwarding headers:
TRUST_PROXY=0
